    month = apr,
    publisher = {CEUR},
    series = {CEUR Workshop Proceedings},
    volume = {1184},
    abstract = {Despite the significant number of existing tools, incorporating
                data from multiple sources and different formats into the Linked
                Open Data cloud remains complicated. No mapping formalisation
                exists to define how to map such heterogeneous sources into RDF
                in an integrated and interoperable fashion. This paper introduces
                the RML mapping language, a generic language based on an
                extension over R2RML, the W3C standard for mapping relational
                databases into RDF. Broadening RML's scope, the language becomes
                source-agnostic and extensible, while facilitating the definition
                of mappings of multiple heterogeneous sources. This leads to
                higher integrity within datasets and richer interlinking among
                resources.},
